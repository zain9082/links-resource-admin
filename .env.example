# Required — PostgreSQL (Neon, Supabase, or Vercel Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/links_resource?sslmode=require"

# Required — random string (openssl rand -base64 32)
AUTH_SECRET="replace-with-long-random-secret"

# Public website URL (for revalidation + “View on website” links)
NEXT_PUBLIC_SITE_URL="https://linksresource.com"

# Shared secret with the public site revalidate API
REVALIDATE_SECRET="replace-with-random-secret"

# Admin seed identity. Runtime login always verifies the database password hash.
ADMIN_EMAIL="admin@linksresource.com"
# Seed job only; remove from the runtime environment after the admin is created.
SEED_ADMIN_PASSWORD="replace-with-strong-password"

# Optional — shared rate-limit store (Upstash Redis REST). If unset, the app
# falls back to a per-instance in-memory limiter (best-effort only on serverless).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional — Vercel Blob for team/media uploads (required in production for uploads)
# Create in Vercel → Storage → Blob, then copy the read-write token here.
BLOB_READ_WRITE_TOKEN=""

# Optional OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
